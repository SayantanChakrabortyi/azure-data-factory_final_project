								},
								"ifTrueActivities": [
									{
										"name": "Copy Cloud data from source to Bronze",
										"type": "Copy",
										"dependsOn": [],
										"policy": {
											"timeout": "0.12:00:00",
											"retry": 5,
											"retryIntervalInSeconds": 60,
											"secureOutput": false,
											"secureInput": false
